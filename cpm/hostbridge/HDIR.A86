;-----------------------------------------------------------------------
; HDIR.CMD: list the host directory. CP/M-86, CP/M 8-16, MP/M 8-16.
;
;       HDIR                    everything in hostdir
;       HDIR *.ASM              only what matches
;       HDIR SRC/               a subdirectory of hostdir
;
; Part of the Host Bridge. The 8086 version of HDIR.ASM: the same steps
; in the same order. Assemble it in the machine:
;
;       ASM86 HDIR              -> HDIR.H86
;       GENCMD HDIR             -> HDIR.CMD
;
; HDIR prints each host name as it is on the host, in its own case and
; at its full length. R and W change a name to fit 8.3.
;
; HDIR makes no BDOS file calls. It uses the console and ports B0H and
; B1H only. The BDOS is INT 224: CL = the function, DX (DL) = the value.
; The code and the data are in separate segments (the small model). DS
; points at the base page: the command tail is at DS:0080H.
;-----------------------------------------------------------------------

;---- CP/M-86 ----------------------------------------------------------
CONOUT	EQU	2		; DL = char
PRSTR	EQU	9		; DX = string, ends in '$'

HNMAX	EQU	64		; a host name can be a path
IDMAX	EQU	32		; room for the board's signature
SZMAX	EQU	20		; a size in decimal (a uint64 is 20 digits)
DTMAX	EQU	12		; room for a date ("MM/DD/YY")
SIZEW	EQU	8		; the width of the size column
CR	EQU	0DH
LF	EQU	0AH

;---- The Host Bridge (HB.INC has the full list) ----------------------
HBCMD	EQU	0B0H		; OUT = command   IN = status
HBDATA	EQU	0B1H		; data, both ways

HEOF	EQU	08H		; the listing has no more names
HERR	EQU	10H		; the last operation failed

CIDENT	EQU	0
CDIRL	EQU	9		; the long listing: name<0> size<0> date<0>
CDIRN	EQU	5		; the next entry. HEOF at the end.
CERROR	EQU	7
CRESET	EQU	8

;=======================================================================
; MAIN
;=======================================================================
	CSEG
	PUSHF			; our own stack, with interrupts off
	POP	AX		; while SS and SP change (as DRI's
	CLI			; RANDOM.A86 does)
	MOV	BX,DS
	MOV	SS,BX
	MOV	SP,OFFSET STACK
	PUSH	AX
	POPF

	CALL	LOCK		; MP/M: one user at a time on the board
	MOV	AL,CRESET	; one byte puts the board in a known
	OUT	HBCMD,AL	; state

	CALL	IDENT		; exits if there is no board
	CALL	PARSE		; the tail -> PAT. The board reads an
				; empty pattern as `*`.

	MOV	COUNT,0		; a 16-bit count: a host directory can
				; hold more than 255 files
	MOV	AL,CDIRL
	OUT	HBCMD,AL
	MOV	SI,OFFSET PAT
	CALL	SENDZ		; the NUL commits the command

;---- the listing loop -------------------------------------------------
DIR1:	IN	AL,HBCMD
	TEST	AL,HERR
	JNZ	DIRBAD		; a bad pattern, or no such hostdir
	TEST	AL,HEOF
	JNZ	DIRE		; no more names. With no matches at all,
				; HDIR comes here on the first pass.

; Each entry is three strings: the name, the size ("<DIR>" for a folder,
; else a decimal byte count) and the date.
	MOV	DI,OFFSET HNAME
	MOV	CX,HNMAX
	CALL	RECVZ
	MOV	DI,OFFSET HSIZE
	MOV	CX,SZMAX
	CALL	RECVZ
	MOV	DI,OFFSET HDATE
	MOV	CX,DTMAX
	CALL	RECVZ

	CALL	SHOW		; one line: <size>  <date>  <name>
	INC	COUNT

	MOV	AL,CDIRN
	OUT	HBCMD,AL
	JMP	DIR1

;---- the count --------------------------------------------------------
DIRE:	CMP	COUNT,0
	JZ	DIRNON
	CALL	CRLF
	MOV	AX,COUNT
	CALL	PRDEC
	MOV	DX,OFFSET MFILES
	CALL	PRINT
	JMP	EXIT

DIRNON: MOV	DX,OFFSET MNONE
	CALL	PRINT
	JMP	EXIT

DIRBAD: CALL	REPERR
				; fall into EXIT
EXIT:	CALL	UNLOCK		; MP/M: give the board back
	MOV	CL,0		; back to the CCP
	MOV	DL,0
	INT	224

;-----------------------------------------------------------------------
; LOCK and UNLOCK: one user at a time on MP/M-86.
;
; The board has one transfer stream. On MP/M, two users who run R, W or
; HDIR at the same time would mix their commands on it. So under MP/M
; the three programs share a mutual exclusion queue, MXhostbr: one
; message of zero length, a binary semaphore (MP/M-86 Programmer's
; Guide 1.3.2). The program that has read the message owns the board.
; It writes the message back at EXIT. If the program is aborted, MP/M
; writes the message back for it (1.3.2 again).
;
; Under CP/M-86 and CP/M 8-16 there is one user, and LOCK does nothing.
; Function 12 tells them apart: AH = 11H is MP/M-86 (p. 80).
;
; LOCK makes the queue the first time (function 134; it fails when the
; queue exists, which is fine), opens it (135), and puts the message in
; if this program made the queue (140, conditional: a full queue is not
; an error). Then it reads the message (138, conditional). If another
; user has it, LOCK says so and waits for it (137).
;-----------------------------------------------------------------------
LOCK:	MOV	CL,12		; RETURN VERSION NUMBER
	INT	224
	CMP	AH,11H
	JNZ	LK9		; not MP/M-86: nothing to share
	MOV	CL,134		; MAKE QUEUE
	MOV	DX,OFFSET MXQD
	INT	224
	MOV	MXMADE,AL	; 0 = this program made it
	MOV	CL,135		; OPEN QUEUE
	MOV	DX,OFFSET MXQPB
	INT	224
	OR	AX,AX
	JNZ	LK9		; no queue: go on without the lock
	CMP	MXMADE,0
	JNZ	LK1
	MOV	CL,140		; COND WRITE QUEUE: the one message
	MOV	DX,OFFSET MXQPB
	INT	224
LK1:	MOV	CL,138		; COND READ QUEUE
	MOV	DX,OFFSET MXQPB
	INT	224
	OR	AX,AX
	JZ	LK2		; the board is ours
	MOV	DX,OFFSET MBUSY
	CALL	PRINT
	MOV	CL,137		; READ QUEUE: wait for the other user
	MOV	DX,OFFSET MXQPB
	INT	224
LK2:	MOV	MXHELD,1
LK9:	RET

UNLOCK: CMP	MXHELD,0
	JZ	UL9
	MOV	MXHELD,0
	MOV	CL,139		; WRITE QUEUE: give the board back
	MOV	DX,OFFSET MXQPB
	INT	224
UL9:	RET

;-----------------------------------------------------------------------
; SHOW: print one entry as a line:  <size>  <date>  <name>
;
;       1792  07/14/26  R.COM
;      <DIR>  07/20/26  SRC/
;
; The size is right-justified in SIZEW columns. The date from the board
; is 8 characters. The name goes last, because it has no fixed length.
; A folder name ends in '/', and its size is "<DIR>".
;-----------------------------------------------------------------------
SHOW:	MOV	SI,OFFSET HSIZE
	MOV	CX,SIZEW
	CALL	RJUST
	CALL	SPC2		; two spaces between the columns
	MOV	SI,OFFSET HDATE
	CALL	PSTR
	CALL	SPC2
	MOV	SI,OFFSET HNAME
	CALL	PSTR
	JMP	CRLF		; tail call: end the line

;-----------------------------------------------------------------------
; RJUST: print the string at SI right-justified in CX columns. It prints
;        (CX - length) spaces, then the string. A string of CX characters
;        or more gets no spaces.
;-----------------------------------------------------------------------
RJUST:	CALL	STRLEN		; BX = the length
	SUB	CX,BX		; CX = the number of spaces
	JBE	RJ2		; as wide as the field, or wider: none
RJ1:	MOV	AL,' '
	CALL	PUTCH		; PUTCH keeps CX and SI
	LOOP	RJ1
RJ2:	JMP	PSTR		; tail call: the string

;-----------------------------------------------------------------------
; SPC2: two spaces, the gap between columns.
;-----------------------------------------------------------------------
SPC2:	MOV	AL,' '
	CALL	PUTCH
	MOV	AL,' '
	JMP	PUTCH		; tail call

;-----------------------------------------------------------------------
; STRLEN: BX = the length of the string at SI. SI does not change.
;-----------------------------------------------------------------------
STRLEN: MOV	BX,0
SL1:	CMP	BYTE PTR [SI+BX],0
	JZ	SL2
	INC	BX
	JMP	SL1
SL2:	RET

;=======================================================================
; THE HOST BRIDGE
;=======================================================================

;-----------------------------------------------------------------------
; IDENT: check that the board is there before anything else.
;
; An IN from a port that no board decodes reads 0FFH, and 0FFH has HEOF
; and HERR set. Without this check, HDIR would print a host error or an
; empty listing.
;-----------------------------------------------------------------------
IDENT:	MOV	AL,CIDENT
	OUT	HBCMD,AL
	MOV	DI,OFFSET IDBUF
	MOV	CX,IDMAX
	CALL	RECVZ		; no terminator (0FFH, no board): RECVZ
				; cuts the string, and the compare fails
	MOV	SI,OFFSET IDBUF
	MOV	DI,OFFSET IDWANT
ID3:	MOV	AL,[DI]
	OR	AL,AL
	JZ	ID4		; all of IDWANT matched. This is a prefix
				; compare, so "... 2" matches too.
	CMP	AL,[SI]
	JNZ	IDBAD
	INC	SI
	INC	DI
	JMP	ID3
ID4:	RET

IDBAD:	MOV	DX,OFFSET MNOHB
	CALL	PRINT
	JMP	EXIT

;-----------------------------------------------------------------------
; SENDZ: send the string at SI to the data port, with its NUL. The NUL
; commits the command.
;-----------------------------------------------------------------------
SENDZ:	MOV	AL,[SI]
	OUT	HBDATA,AL
	INC	SI
	OR	AL,AL
	JNZ	SENDZ
	RET

;-----------------------------------------------------------------------
; RECVZ: read a string from the data port into DI.
;        CX = the room, without the NUL: the buffer is CX+1 bytes.
;-----------------------------------------------------------------------
RECVZ:	IN	AL,HBDATA
	MOV	[DI],AL
	OR	AL,AL
	JZ	RZ2
	INC	DI
	LOOP	RECVZ
	MOV	BYTE PTR [DI],0	; no room left: cut the string here
RZ2:	RET

;-----------------------------------------------------------------------
; REPERR: print the board's error message, in the host's words.
;-----------------------------------------------------------------------
REPERR: MOV	AL,CERROR
	OUT	HBCMD,AL
	IN	AL,HBDATA	; the code byte: skip it
	MOV	DX,OFFSET MERR
	CALL	PRINT
RPE1:	IN	AL,HBDATA	; then the text, one character at a time
	OR	AL,AL
	JZ	RPE2
	CALL	PUTCH
	JMP	RPE1
RPE2:	JMP	CRLF		; tail call

;=======================================================================
; THE COMMAND TAIL
;=======================================================================

;-----------------------------------------------------------------------
; PARSE: the first word of the tail at 0080H -> PAT.
;
; HDIR does not use the CCP's FCB at 005CH. The CCP parses the word as
; 8.3, so `SRC/` would lose its slash.
;-----------------------------------------------------------------------
PARSE:	MOV	SI,OFFSET TAIL+1
	MOV	CL,TAIL		; the length of the tail
	MOV	CH,0
PS1:	JCXZ	PS2		; skip the spaces
	CMP	BYTE PTR [SI],' '
	JNZ	PS2
	INC	SI
	DEC	CX
	JMP	PS1
PS2:	MOV	DI,OFFSET PAT	; copy one word, and end it with a NUL
	MOV	DX,HNMAX	; DX = the room left
PS3:	JCXZ	PS4
	OR	DX,DX
	JZ	PS4
	MOV	AL,[SI]
	CMP	AL,' '
	JZ	PS4
	MOV	[DI],AL
	INC	SI
	INC	DI
	DEC	CX
	DEC	DX
	JMP	PS3
PS4:	MOV	BYTE PTR [DI],0	; with no word, PAT is an empty string
	RET

;=======================================================================
; MESSAGES TO THE USER
;=======================================================================

; PSTR: print the string at SI.
PSTR:	MOV	AL,[SI]
	OR	AL,AL
	JZ	PSTR2
	CALL	PUTCH
	INC	SI
	JMP	PSTR
PSTR2:	RET

; PUTCH: print the character in AL. Keeps CX, SI and DI: the BDOS
; can change any register but the segment registers.
PUTCH:	PUSH	CX
	PUSH	SI
	PUSH	DI
	MOV	DL,AL
	MOV	CL,CONOUT
	INT	224
	POP	DI
	POP	SI
	POP	CX
	RET

; PRINT: print the '$' string at DX.
PRINT:	MOV	CL,PRSTR
	INT	224
	RET

CRLF:	MOV	DX,OFFSET MCRLF
	JMP	PRINT

;-----------------------------------------------------------------------
; PRDEC: print AX in decimal. The digits go into a buffer from the end.
;-----------------------------------------------------------------------
PRDEC:	MOV	DI,OFFSET NUMEND
	MOV	BYTE PTR [DI],'$'
	MOV	BX,10
PD1:	DEC	DI
	MOV	DX,0
	DIV	BX		; AX = AX/10, DX = the remainder
	ADD	DL,'0'
	MOV	[DI],DL
	OR	AX,AX
	JNZ	PD1
	MOV	DX,DI		; the first digit
	JMP	PRINT

;=======================================================================
; DATA. The base page is at DS:0000; the program's data starts at 0100H.
;=======================================================================
	DSEG
	ORG	0080H
TAIL	RB	128		; the command tail: length, then the text.
				; The CCP folds it to upper case. The board
				; folds host names to match, and prints
				; each name in its own case.
	ORG	0100H
IDWANT	DB	'ALTAIRSIM HOSTBRIDGE',0

MNOHB	DB	CR,LF,'HDIR: no hostbridge board at port B0H.',CR,LF
	DB	'Add a hostbridge board to the machine, or set its port'
	DB	' to B0.',CR,LF,'$'

MERR	DB	'HDIR: $'
MCRLF	DB	CR,LF,'$'
MFILES	DB	' files.',CR,LF,'$'
MNONE	DB	'HDIR: nothing matches.',CR,LF,'$'

MBUSY	DB	'HDIR: another user has the host bridge. Waiting...',CR,LF,'$'

; The MP/M-86 queue that LOCK and UNLOCK use (Programmer's Guide
; Figures 6-8 and 6-9).
MXQD	DW	0,0		; QD: internal, zero
	DW	0001H		; flags: mutual exclusion
	DB	'MXhostbr'	; the name: all 8 bytes count
	DW	0		; MSGLEN: a message of zero length
	DW	1		; NMSGS: one message
	DW	0,0,0,0		; internal, zero
	DW	0		; BUFFER: 0 from a transient program
MXQPB	DW	0		; QPB: reserved, set by OPEN QUEUE
	DW	0		; the queue ID, set by OPEN QUEUE
	DW	1		; NMSGS: one message a read or a write
	DW	OFFSET MXQPB	; BUFFER: the message has no bytes
	DB	'MXhostbr'
MXMADE	DB	0FFH		; 0 = this program made the queue
MXHELD	DB	0		; 1 = this program has the message

;---- variables --------------------------------------------------------
PAT	RB	HNMAX+1		; the pattern as typed. Empty = everything.
HNAME	RB	HNMAX+1		; the name from the board
HSIZE	RB	SZMAX+1		; its size as decimal text, or "<DIR>"
HDATE	RB	DTMAX+1		; its date, MM/DD/YY
IDBUF	RB	IDMAX+1
COUNT	RW	1		; the names printed
NUMBUF	RB	6
NUMEND	RB	1		; PRDEC ends here

	RW	64		; the stack
STACK	RB	1
	DB	0		; an end byte, so GENCMD keeps all of the
				; data segment (as in DRI's RANDOM.A86)
	END
