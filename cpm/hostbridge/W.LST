                        ; The MP/M-86 queue that LOCK and UNLOCK use (Programmer's Guide
                        ; Figures 6-8 and 6-9).
 066E 00000000          MXQD    DW      0,0             ; QD: internal, zero
 0672 0100                      DW      0001H           ; flags: mutual exclusion
 0674 4D58686F7374              DB      'MXhostbr'      ; the name: all 8 bytes count
      6272
 067C 0000                      DW      0               ; MSGLEN: a message of zero length
 067E 0100                      DW      1               ; NMSGS: one message
 0680 000000000000              DW      0,0,0,0         ; internal, zero
      0000
 0688 0000                      DW      0               ; BUFFER: 0 from a transient program
 068A 0000              MXQPB   DW      0               ; QPB: reserved, set by OPEN QUEUE
 068C 0000                      DW      0               ; the queue ID, set by OPEN QUEUE
CP/M ASM86 1.1  SOURCE: W.A86                                                                                PAGE  23


 068E 0100                      DW      1               ; NMSGS: one message a read or a write
 0690 8A06                      DW      OFFSET MXQPB    ; BUFFER: the message has no bytes
 0692 4D58686F7374              DB      'MXhostbr'
      6272
 069A FF                MXMADE  DB      0FFH            ; 0 = this program made the queue
 069B 00                MXHELD  DB      0               ; 1 = this program has the message

                        ;---- Variables -------------------------------------------------------
                        ; BUF: the DMA buffer, one CP/M record. BDOS READ and SEARCH put their
                        ; data here.
 069C                   BUF     RB      RECLEN
 071C                   MODE    RB      1               ; the switch, when one was given (PARSE)
 071D                   MODSET  RB      1               ; 1 = a switch was given (PARSE)
 071E                   DRIVE   RB      1               ; the drive the user gave (INIFCB)
 071F                   XMODE   RB      1               ; B or T for this file (PICKMD)
 0720                   AUTO    RB      1               ; 1 = the extension chose T
 0721                   RECS    RW      1               ; records read from CP/M
 0723                   BYTESL  RW      1               ; the true byte count, 32 bits: the low
 0725                   BYTESH  RW      1               ; word and the high word
 0727                   FCB     RB      36              ; W's copy of the CCP's FCB (INIFCB)
 074B                   HNAME   RB      HNMAX+1         ; the host name, given or made
 078C                   HDIRP   RB      HNMAX+2         ; a wildcard's host folder, "SRC/" (SETDIR)
 07CE                   CNAME   RB      HNMAX+1         ; the first word of the tail
 080F                   TOK2    RB      HNMAX+1
 0850                   TOK3    RB      HNMAX+1
 0891                   IDBUF   RB      IDMAX+1         ; the board's signature
 08B2                   NUMBUF  RB      10              ; 4294967295 is 10 digits
 08BC                   NUMEND  RB      1               ; PRDEC builds back from here

 08BD                   NCNT    RW      1               ; how many matches W found
 08BF                   DONE    RW      1               ; how many it has copied
 08C1                   NPTR    RW      1               ; the collect cursor into NAMES
 08C3                   CPTR    RW      1               ; the copy cursor into NAMES
 08C5                   NAMES   RB      MAXN*11         ; 11 characters each, no dot, no drive

 0B85                           RW      64              ; the stack
 0C05                   STACK   RB      1
 0C06 00                        DB      0               ; an end byte, so GENCMD keeps all of the
                                                        ; data segment (as in DRI's RANDOM.A86)
                                END


