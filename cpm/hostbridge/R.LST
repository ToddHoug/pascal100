                        ; The MP/M-86 queue that LOCK and UNLOCK use (Programmer's Guide
                        ; Figures 6-8 and 6-9).
 049A 00000000          MXQD    DW      0,0             ; QD: internal, zero
 049E 0100                      DW      0001H           ; flags: mutual exclusion
 04A0 4D58686F7374              DB      'MXhostbr'      ; the name: all 8 bytes count
      6272
 04A8 0000                      DW      0               ; MSGLEN: a message of zero length
 04AA 0100                      DW      1               ; NMSGS: one message
 04AC 000000000000              DW      0,0,0,0         ; internal, zero
      0000
 04B4 0000                      DW      0               ; BUFFER: 0 from a transient program
 04B6 0000              MXQPB   DW      0               ; QPB: reserved, set by OPEN QUEUE
 04B8 0000                      DW      0               ; the queue ID, set by OPEN QUEUE
 04BA 0100                      DW      1               ; NMSGS: one message a read or a write
 04BC B604                      DW      OFFSET MXQPB    ; BUFFER: the message has no bytes
 04BE 4D58686F7374              DB      'MXhostbr'
      6272
 04C6 FF                MXMADE  DB      0FFH            ; 0 = this program made the queue
 04C7 00                MXHELD  DB      0               ; 1 = this program has the message

                        ;---- variables --------------------------------------------------------
 04C8                   BUF     RB      RECLEN          ; the DMA buffer: one CP/M record
 0548                   RECS    RW      1               ; records written to CP/M
 054A                   BYTESL  RW      1               ; the host byte count, 32 bits: the low
 054C                   BYTESH  RW      1               ; word and the high word
