 03E0 BA8B01            USAGE:  MOV     DX,OFFSET MUSAGE
 03E3 E8EFFF       03D5         CALL    PRINT
 03E6 E97EFC       0067         JMP     EXIT

 03E9 BA7203            EWILD:  MOV     DX,OFFSET MEWILD
 03EC E8E6FF       03D5         CALL    PRINT
 03EF E975FC       0067         JMP     EXIT

 03F2 BA2B04            EWORD:  MOV     DX,OFFSET MEWORD
 03F5 E8DDFF       03D5         CALL    PRINT
 03F8 E96CFC       0067         JMP     EXIT

                        ; ENODIR, EDISK and ECLOSE come from inside ONE (EDISK from inside COPY,
                        ; which ONE called), so ESAY returns, with CY set.
 03FB BADD03            ENODIR: MOV     DX,OFFSET MENODIR
 03FE E90900       040A         JMP     ESAY
 0401 BAFE03            EDISK:  MOV     DX,OFFSET MEDISK
 0404 E90300       040A         JMP     ESAY
 0407 BA4404            ECLOSE: MOV     DX,OFFSET MECLOSE
 040A E8C8FF       03D5 ESAY:   CALL    PRINT
 040D F9                        STC
 040E C3                        RET

