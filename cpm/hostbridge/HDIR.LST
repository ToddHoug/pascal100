CP/M ASM86 1.1  SOURCE: HDIR.A86                                                                             PAGE   1


                        ;-----------------------------------------------------------------------
                        ; HDIR.CMD: list the host directory. CP/M-86, CP/M 8-16, MP/M 8-16.
                        ;
                        ;       HDIR                    everything in hostdir
                        ;       HDIR *.ASM              only what matches
                        ;       HDIR SRC/               a subdirectory of hostdir
                        ;
                        ; Part of the Host Bridge. The 8086 version of HDIR.ASM: the same steps
                        ; in the same order. Assemble it in the machine:
                        ;
                        ;       ASM86 HDIR              -> HDIR.H86
                        ;       GENCMD HDIR             -> HDIR.CMD
                        ;
                        ; HDIR prints each host name as it is on the host, in its own case and
                        ; at its full length. R and W change a name to fit 8.3.
                        ;
                        ; HDIR makes no BDOS file calls. It uses the console and ports B0H and
                        ; B1H only. The BDOS is INT 224: CL = the function, DX (DL) = the value.
                        ; The code and the data are in separate segments (the small model). DS
                        ; points at the base page: the command tail is at DS:0080H.
                        ;-----------------------------------------------------------------------

                        ;---- CP/M-86 ----------------------------------------------------------
   0002                 CONOUT  EQU     2               ; DL = char
   0009                 PRSTR   EQU     9               ; DX = string, ends in '$'

   0040                 HNMAX   EQU     64              ; a host name can be a path
   0020                 IDMAX   EQU     32              ; room for the board's signature
   0014                 SZMAX   EQU     20              ; a size in decimal (a uint64 is 20 digits)
   000C                 DTMAX   EQU     12              ; room for a date ("MM/DD/YY")
   0008                 SIZEW   EQU     8               ; the width of the size column
   000D                 CR      EQU     0DH
   000A                 LF      EQU     0AH

                        ;---- The Host Bridge (HB.INC has the full list) ----------------------
   00B0                 HBCMD   EQU     0B0H            ; OUT = command   IN = status
   00B1                 HBDATA  EQU     0B1H            ; data, both ways

   0008                 HEOF    EQU     08H             ; the listing has no more names
   0010                 HERR    EQU     10H             ; the last operation failed

   0000                 CIDENT  EQU     0
   0009                 CDIRL   EQU     9               ; the long listing: name<0> size<0> date<0>
   0005                 CDIRN   EQU     5               ; the next entry. HEOF at the end.
   0007                 CERROR  EQU     7
   0008                 CRESET  EQU     8

                        ;=======================================================================
                        ; MAIN
                        ;=======================================================================
                                CSEG
 0000 9C                        PUSHF                   ; our own stack, with interrupts off
CP/M ASM86 1.1  SOURCE: HDIR.A86                                                                             PAGE   2


 0001 58                        POP     AX              ; while SS and SP change (as DRI's
 0002 FA                        CLI                     ; RANDOM.A86 does)
 0003 8CDB                      MOV     BX,DS
 0005 8ED3                      MOV     SS,BX
 0007 BC5D03                    MOV     SP,OFFSET STACK
 000A 50                        PUSH    AX
 000B 9D                        POPF

 000C E87B00       008A         CALL    LOCK            ; MP/M: one user at a time on the board
 000F B008                      MOV     AL,CRESET       ; one byte puts the board in a known
 0011 E6B0                      OUT     HBCMD,AL        ; state

 0013 E81801       012E         CALL    IDENT           ; exits if there is no board
 0016 E87501       018E         CALL    PARSE           ; the tail -> PAT. The board reads an
                                                        ; empty pattern as `*`.

 0019 C706D4020000              MOV     COUNT,0         ; a 16-bit count: a host directory can
                                                        ; hold more than 255 files
 001F B009                      MOV     AL,CDIRL
 0021 E6B0                      OUT     HBCMD,AL
 0023 BE0F02                    MOV     SI,OFFSET PAT
 0026 E83101       015A         CALL    SENDZ           ; the NUL commits the command

                        ;---- the listing loop -------------------------------------------------
 0029 E4B0              DIR1:   IN      AL,HBCMD
 002B A810                      TEST    AL,HERR
 002D 754F         007E         JNZ     DIRBAD          ; a bad pattern, or no such hostdir
 002F A808                      TEST    AL,HEOF
 0031 7529         005C         JNZ     DIRE            ; no more names. With no matches at all,
                                                        ; HDIR comes here on the first pass.

                        ; Each entry is three strings: the name, the size ("<DIR>" for a folder,
                        ; else a decimal byte count) and the date.
 0033 BF5002                    MOV     DI,OFFSET HNAME
 0036 B94000                    MOV     CX,HNMAX
 0039 E82801       0164         CALL    RECVZ
 003C BF9102                    MOV     DI,OFFSET HSIZE
 003F B91400                    MOV     CX,SZMAX
 0042 E81F01       0164         CALL    RECVZ
 0045 BFA602                    MOV     DI,OFFSET HDATE
 0048 B90C00                    MOV     CX,DTMAX
 004B E81601       0164         CALL    RECVZ

 004E E89700       00E8         CALL    SHOW            ; one line: <size>  <date>  <name>
 0051 FF06D402                  INC     COUNT

 0055 B005                      MOV     AL,CDIRN
 0057 E6B0                      OUT     HBCMD,AL
 0059 E9CDFF       0029         JMP     DIR1

                        ;---- the count --------------------------------------------------------
 005C 833ED40200        DIRE:   CMP     COUNT,0
CP/M ASM86 1.1  SOURCE: HDIR.A86                                                                             PAGE   3


 0061 7412         0075         JZ      DIRNON
 0063 E87C01       01E2         CALL    CRLF
 0066 A1D402                    MOV     AX,COUNT
 0069 E87C01       01E8         CALL    PRDEC
 006C BA8901                    MOV     DX,OFFSET MFILES
 006F E86B01       01DD         CALL    PRINT
 0072 E90C00       0081         JMP     EXIT

 0075 BA9301            DIRNON: MOV     DX,OFFSET MNONE
 0078 E86201       01DD         CALL    PRINT
 007B E90300       0081         JMP     EXIT

 007E E8F200       0173 DIRBAD: CALL    REPERR
                                                        ; fall into EXIT
 0081 E85000       00D4 EXIT:   CALL    UNLOCK          ; MP/M: give the board back
 0084 B100                      MOV     CL,0            ; back to the CCP
 0086 B200                      MOV     DL,0
 0088 CDE0                      INT     224

                        ;-----------------------------------------------------------------------
                        ; LOCK and UNLOCK: one user at a time on MP/M-86.
                        ;
                        ; The board has one transfer stream. On MP/M, two users who run R, W or
                        ; HDIR at the same time would mix their commands on it. So under MP/M
                        ; the three programs share a mutual exclusion queue, MXhostbr: one
                        ; message of zero length, a binary semaphore (MP/M-86 Programmer's
                        ; Guide 1.3.2). The program that has read the message owns the board.
                        ; It writes the message back at EXIT. If the program is aborted, MP/M
                        ; writes the message back for it (1.3.2 again).
                        ;
                        ; Under CP/M-86 and CP/M 8-16 there is one user, and LOCK does nothing.
                        ; Function 12 tells them apart: AH = 11H is MP/M-86 (p. 80).
                        ;
                        ; LOCK makes the queue the first time (function 134; it fails when the
                        ; queue exists, which is fine), opens it (135), and puts the message in
                        ; if this program made the queue (140, conditional: a full queue is not
                        ; an error). Then it reads the message (138, conditional). If another
                        ; user has it, LOCK says so and waits for it (137).
                        ;-----------------------------------------------------------------------
 008A B10C              LOCK:   MOV     CL,12           ; RETURN VERSION NUMBER
 008C CDE0                      INT     224
 008E 80FC11                    CMP     AH,11H
 0091 7540         00D3         JNZ     LK9             ; not MP/M-86: nothing to share
 0093 B186                      MOV     CL,134          ; MAKE QUEUE
 0095 BAE101                    MOV     DX,OFFSET MXQD
 0098 CDE0                      INT     224
 009A A20D02                    MOV     MXMADE,AL       ; 0 = this program made it
 009D B187                      MOV     CL,135          ; OPEN QUEUE
 009F BAFD01                    MOV     DX,OFFSET MXQPB
 00A2 CDE0                      INT     224
 00A4 0BC0                      OR      AX,AX
 00A6 752B         00D3         JNZ     LK9             ; no queue: go on without the lock
CP/M ASM86 1.1  SOURCE: HDIR.A86                                                                             PAGE   4


 00A8 803E0D0200                CMP     MXMADE,0
 00AD 7507         00B6         JNZ     LK1
 00AF B18C                      MOV     CL,140          ; COND WRITE QUEUE: the one message
 00B1 BAFD01                    MOV     DX,OFFSET MXQPB
 00B4 CDE0                      INT     224
 00B6 B18A              LK1:    MOV     CL,138          ; COND READ QUEUE
 00B8 BAFD01                    MOV     DX,OFFSET MXQPB
 00BB CDE0                      INT     224
 00BD 0BC0                      OR      AX,AX
 00BF 740D         00CE         JZ      LK2             ; the board is ours
 00C1 BAAC01                    MOV     DX,OFFSET MBUSY
 00C4 E81601       01DD         CALL    PRINT
 00C7 B189                      MOV     CL,137          ; READ QUEUE: wait for the other user
 00C9 BAFD01                    MOV     DX,OFFSET MXQPB
 00CC CDE0                      INT     224
 00CE C6060E0201        LK2:    MOV     MXHELD,1
 00D3 C3                LK9:    RET

 00D4 803E0E0200        UNLOCK: CMP     MXHELD,0
 00D9 740C         00E7         JZ      UL9
 00DB C6060E0200                MOV     MXHELD,0
 00E0 B18B                      MOV     CL,139          ; WRITE QUEUE: give the board back
 00E2 BAFD01                    MOV     DX,OFFSET MXQPB
 00E5 CDE0                      INT     224
 00E7 C3                UL9:    RET

                        ;-----------------------------------------------------------------------
                        ; SHOW: print one entry as a line:  <size>  <date>  <name>
                        ;
                        ;       1792  07/14/26  R.COM
                        ;      <DIR>  07/20/26  SRC/
                        ;
                        ; The size is right-justified in SIZEW columns. The date from the board
                        ; is 8 characters. The name goes last, because it has no fixed length.
                        ; A folder name ends in '/', and its size is "<DIR>".
                        ;-----------------------------------------------------------------------
 00E8 BE9102            SHOW:   MOV     SI,OFFSET HSIZE
 00EB B90800                    MOV     CX,SIZEW
 00EE E81500       0106         CALL    RJUST
 00F1 E82300       0117         CALL    SPC2            ; two spaces between the columns
 00F4 BEA602                    MOV     SI,OFFSET HDATE
 00F7 E8C800       01C2         CALL    PSTR
 00FA E81A00       0117         CALL    SPC2
 00FD BE5002                    MOV     SI,OFFSET HNAME
 0100 E8BF00       01C2         CALL    PSTR
 0103 E9DC00       01E2         JMP     CRLF            ; tail call: end the line

                        ;-----------------------------------------------------------------------
                        ; RJUST: print the string at SI right-justified in CX columns. It prints
                        ;        (CX - length) spaces, then the string. A string of CX characters
                        ;        or more gets no spaces.
                        ;-----------------------------------------------------------------------
CP/M ASM86 1.1  SOURCE: HDIR.A86                                                                             PAGE   5


 0106 E81800       0121 RJUST:  CALL    STRLEN          ; BX = the length
 0109 2BCB                      SUB     CX,BX           ; CX = the number of spaces
 010B 7607         0114         JBE     RJ2             ; as wide as the field, or wider: none
 010D B020              RJ1:    MOV     AL,' '
 010F E8BE00       01D0         CALL    PUTCH           ; PUTCH keeps CX and SI
 0112 E2F9         010D         LOOP    RJ1
 0114 E9AB00       01C2 RJ2:    JMP     PSTR            ; tail call: the string

                        ;-----------------------------------------------------------------------
                        ; SPC2: two spaces, the gap between columns.
                        ;-----------------------------------------------------------------------
 0117 B020              SPC2:   MOV     AL,' '
 0119 E8B400       01D0         CALL    PUTCH
 011C B020                      MOV     AL,' '
 011E E9AF00       01D0         JMP     PUTCH           ; tail call

                        ;-----------------------------------------------------------------------
                        ; STRLEN: BX = the length of the string at SI. SI does not change.
                        ;-----------------------------------------------------------------------
 0121 BB0000            STRLEN: MOV     BX,0
 0124 803800            SL1:    CMP     BYTE PTR [SI+BX],0
 0127 7404         012D         JZ      SL2
 0129 43                        INC     BX
 012A E9F7FF       0124         JMP     SL1
 012D C3                SL2:    RET

                        ;=======================================================================
                        ; THE HOST BRIDGE
                        ;=======================================================================

                        ;-----------------------------------------------------------------------
                        ; IDENT: check that the board is there before anything else.
                        ;
                        ; An IN from a port that no board decodes reads 0FFH, and 0FFH has HEOF
                        ; and HERR set. Without this check, HDIR would print a host error or an
                        ; empty listing.
                        ;-----------------------------------------------------------------------
 012E B000              IDENT:  MOV     AL,CIDENT
 0130 E6B0                      OUT     HBCMD,AL
 0132 BFB302                    MOV     DI,OFFSET IDBUF
 0135 B92000                    MOV     CX,IDMAX
 0138 E82900       0164         CALL    RECVZ           ; no terminator (0FFH, no board): RECVZ
                                                        ; cuts the string, and the compare fails
 013B BEB302                    MOV     SI,OFFSET IDBUF
 013E BF0001                    MOV     DI,OFFSET IDWANT
 0141 8A05              ID3:    MOV     AL,[DI]
 0143 0AC0                      OR      AL,AL
 0145 7409         0150         JZ      ID4             ; all of IDWANT matched. This is a prefix
                                                        ; compare, so "... 2" matches too.
 0147 3A04                      CMP     AL,[SI]
 0149 7506         0151         JNZ     IDBAD
 014B 46                        INC     SI
CP/M ASM86 1.1  SOURCE: HDIR.A86                                                                             PAGE   6


 014C 47                        INC     DI
 014D E9F1FF       0141         JMP     ID3
 0150 C3                ID4:    RET

 0151 BA1501            IDBAD:  MOV     DX,OFFSET MNOHB
 0154 E88600       01DD         CALL    PRINT
 0157 E927FF       0081         JMP     EXIT

                        ;-----------------------------------------------------------------------
                        ; SENDZ: send the string at SI to the data port, with its NUL. The NUL
                        ; commits the command.
                        ;-----------------------------------------------------------------------
 015A 8A04              SENDZ:  MOV     AL,[SI]
 015C E6B1                      OUT     HBDATA,AL
 015E 46                        INC     SI
 015F 0AC0                      OR      AL,AL
 0161 75F7         015A         JNZ     SENDZ
 0163 C3                        RET

                        ;-----------------------------------------------------------------------
                        ; RECVZ: read a string from the data port into DI.
                        ;        CX = the room, without the NUL: the buffer is CX+1 bytes.
                        ;-----------------------------------------------------------------------
 0164 E4B1              RECVZ:  IN      AL,HBDATA
 0166 8805                      MOV     [DI],AL
 0168 0AC0                      OR      AL,AL
 016A 7406         0172         JZ      RZ2
 016C 47                        INC     DI
 016D E2F5         0164         LOOP    RECVZ
 016F C60500                    MOV     BYTE PTR [DI],0 ; no room left: cut the string here
 0172 C3                RZ2:    RET

                        ;-----------------------------------------------------------------------
                        ; REPERR: print the board's error message, in the host's words.
                        ;-----------------------------------------------------------------------
 0173 B007              REPERR: MOV     AL,CERROR
 0175 E6B0                      OUT     HBCMD,AL
 0177 E4B1                      IN      AL,HBDATA       ; the code byte: skip it
 0179 BA7F01                    MOV     DX,OFFSET MERR
 017C E85E00       01DD         CALL    PRINT
 017F E4B1              RPE1:   IN      AL,HBDATA       ; then the text, one character at a time
 0181 0AC0                      OR      AL,AL
 0183 7406         018B         JZ      RPE2
 0185 E84800       01D0         CALL    PUTCH
 0188 E9F4FF       017F         JMP     RPE1
 018B E95400       01E2 RPE2:   JMP     CRLF            ; tail call

                        ;=======================================================================
                        ; THE COMMAND TAIL
                        ;=======================================================================

                        ;-----------------------------------------------------------------------
CP/M ASM86 1.1  SOURCE: HDIR.A86                                                                             PAGE   7


                        ; PARSE: the first word of the tail at 0080H -> PAT.
                        ;
                        ; HDIR does not use the CCP's FCB at 005CH. The CCP parses the word as
                        ; 8.3, so `SRC/` would lose its slash.
                        ;-----------------------------------------------------------------------
 018E BE8100            PARSE:  MOV     SI,OFFSET TAIL+1
 0191 8A0E8000                  MOV     CL,TAIL         ; the length of the tail
 0195 B500                      MOV     CH,0
 0197 E30A         01A3 PS1:    JCXZ    PS2             ; skip the spaces
 0199 803C20                    CMP     BYTE PTR [SI],' '
 019C 7505         01A3         JNZ     PS2
 019E 46                        INC     SI
 019F 49                        DEC     CX
 01A0 E9F4FF       0197         JMP     PS1
 01A3 BF0F02            PS2:    MOV     DI,OFFSET PAT   ; copy one word, and end it with a NUL
 01A6 BA4000                    MOV     DX,HNMAX        ; DX = the room left
 01A9 E313         01BE PS3:    JCXZ    PS4
 01AB 0BD2                      OR      DX,DX
 01AD 740F         01BE         JZ      PS4
 01AF 8A04                      MOV     AL,[SI]
 01B1 3C20                      CMP     AL,' '
 01B3 7409         01BE         JZ      PS4
 01B5 8805                      MOV     [DI],AL
 01B7 46                        INC     SI
 01B8 47                        INC     DI
 01B9 49                        DEC     CX
 01BA 4A                        DEC     DX
 01BB E9EBFF       01A9         JMP     PS3
 01BE C60500            PS4:    MOV     BYTE PTR [DI],0 ; with no word, PAT is an empty string
 01C1 C3                        RET

                        ;=======================================================================
                        ; MESSAGES TO THE USER
                        ;=======================================================================

                        ; PSTR: print the string at SI.
 01C2 8A04              PSTR:   MOV     AL,[SI]
 01C4 0AC0                      OR      AL,AL
 01C6 7407         01CF         JZ      PSTR2
 01C8 E80500       01D0         CALL    PUTCH
 01CB 46                        INC     SI
 01CC E9F3FF       01C2         JMP     PSTR
 01CF C3                PSTR2:  RET

                        ; PUTCH: print the character in AL. Keeps CX, SI and DI: the BDOS
                        ; can change any register but the segment registers.
 01D0 51                PUTCH:  PUSH    CX
 01D1 56                        PUSH    SI
 01D2 57                        PUSH    DI
 01D3 8AD0                      MOV     DL,AL
 01D5 B102                      MOV     CL,CONOUT
 01D7 CDE0                      INT     224
CP/M ASM86 1.1  SOURCE: HDIR.A86                                                                             PAGE   8


 01D9 5F                        POP     DI
 01DA 5E                        POP     SI
 01DB 59                        POP     CX
 01DC C3                        RET

                        ; PRINT: print the '$' string at DX.
 01DD B109              PRINT:  MOV     CL,PRSTR
 01DF CDE0                      INT     224
 01E1 C3                        RET

 01E2 BA8601            CRLF:   MOV     DX,OFFSET MCRLF
 01E5 E9F5FF       01DD         JMP     PRINT

                        ;-----------------------------------------------------------------------
                        ; PRDEC: print AX in decimal. The digits go into a buffer from the end.
                        ;-----------------------------------------------------------------------
 01E8 BFDC02            PRDEC:  MOV     DI,OFFSET NUMEND
 01EB C60524                    MOV     BYTE PTR [DI],'$'
 01EE BB0A00                    MOV     BX,10
 01F1 4F                PD1:    DEC     DI
 01F2 BA0000                    MOV     DX,0
 01F5 F7F3                      DIV     BX              ; AX = AX/10, DX = the remainder
 01F7 80C230                    ADD     DL,'0'
 01FA 8815                      MOV     [DI],DL
 01FC 0BC0                      OR      AX,AX
 01FE 75F1         01F1         JNZ     PD1
 0200 8BD7                      MOV     DX,DI           ; the first digit
 0202 E9D8FF       01DD         JMP     PRINT

                        ;=======================================================================
                        ; DATA. The base page is at DS:0000; the program's data starts at 0100H.
                        ;=======================================================================
                                DSEG
                                ORG     0080H
 0080                   TAIL    RB      128             ; the command tail: length, then the text.
                                                        ; The CCP folds it to upper case. The board
                                                        ; folds host names to match, and prints
                                                        ; each name in its own case.
                                ORG     0100H
 0100 414C54414952      IDWANT  DB      'ALTAIRSIM HOSTBRIDGE',0
      53494D20484F
      535442524944
      474500

 0115 0D0A48444952      MNOHB   DB      CR,LF,'HDIR: no hostbridge board at port B0H.',CR,LF
      3A206E6F2068
      6F7374627269
      64676520626F
      617264206174
      20706F727420
      4230482E0D0A
 013F 416464206120              DB      'Add a hostbridge board to the machine, or set its port'
CP/M ASM86 1.1  SOURCE: HDIR.A86                                                                             PAGE   9


      686F73746272
      696467652062
      6F6172642074
      6F2074686520
      6D616368696E
      652C206F7220
      736574206974
      7320706F7274
 0175 20746F204230              DB      ' to B0.',CR,LF,'$'
      2E0D0A24

 017F 484449523A20      MERR    DB      'HDIR: $'
      24
 0186 0D0A24            MCRLF   DB      CR,LF,'$'
 0189 2066696C6573      MFILES  DB      ' files.',CR,LF,'$'
      2E0D0A24
 0193 484449523A20      MNONE   DB      'HDIR: nothing matches.',CR,LF,'$'
      6E6F7468696E
      67206D617463
      6865732E0D0A
      24

 01AC 484449523A20      MBUSY   DB      'HDIR: another user has the host bridge. Waiting...',CR,LF,'$'
      616E6F746865
      722075736572
      206861732074
      686520686F73
      742062726964
      67652E205761
      6974696E672E
      2E2E0D0A24

                        ; The MP/M-86 queue that LOCK and UNLOCK use (Programmer's Guide
                        ; Figures 6-8 and 6-9).
 01E1 00000000          MXQD    DW      0,0             ; QD: internal, zero
 01E5 0100                      DW      0001H           ; flags: mutual exclusion
 01E7 4D58686F7374              DB      'MXhostbr'      ; the name: all 8 bytes count
      6272
 01EF 0000                      DW      0               ; MSGLEN: a message of zero length
 01F1 0100                      DW      1               ; NMSGS: one message
 01F3 000000000000              DW      0,0,0,0         ; internal, zero
      0000
 01FB 0000                      DW      0               ; BUFFER: 0 from a transient program
 01FD 0000              MXQPB   DW      0               ; QPB: reserved, set by OPEN QUEUE
 01FF 0000                      DW      0               ; the queue ID, set by OPEN QUEUE
 0201 0100                      DW      1               ; NMSGS: one message a read or a write
 0203 FD01                      DW      OFFSET MXQPB    ; BUFFER: the message has no bytes
 0205 4D58686F7374              DB      'MXhostbr'
      6272
 020D FF                MXMADE  DB      0FFH            ; 0 = this program made the queue
 020E 00                MXHELD  DB      0               ; 1 = this program has the message

CP/M ASM86 1.1  SOURCE: HDIR.A86                                                                             PAGE  10


                        ;---- variables --------------------------------------------------------
 020F                   PAT     RB      HNMAX+1         ; the pattern as typed. Empty = everything.
 0250                   HNAME   RB      HNMAX+1         ; the name from the board
 0291                   HSIZE   RB      SZMAX+1         ; its size as decimal text, or "<DIR>"
 02A6                   HDATE   RB      DTMAX+1         ; its date, MM/DD/YY
 02B3                   IDBUF   RB      IDMAX+1
 02D4                   COUNT   RW      1               ; the names printed
 02D6                   NUMBUF  RB      6
 02DC                   NUMEND  RB      1               ; PRDEC ends here

 02DD                           RW      64              ; the stack
 035D                   STACK   RB      1
 035E 00                        DB      0               ; an end byte, so GENCMD keeps all of the
                                                        ; data segment (as in DRI's RANDOM.A86)
                                END


END OF ASSEMBLY.  NUMBER OF ERRORS:   0.  USE FACTOR:  2%
